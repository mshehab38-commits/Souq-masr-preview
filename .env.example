# Postgres connection string used by Prisma
DATABASE_URL="postgresql://souqmasr:souqmasr_dev_pw@localhost:5432/souqmasr?schema=public"

# Redis connection string (cache, rate limiting, BullMQ queues)
REDIS_URL="redis://localhost:6379"

# Base URL of the app (used for absolute links, webhooks, OG tags)
APP_URL="http://localhost:3000"

# Node environment
NODE_ENV="development"

# Secret pepper mixed into OTP code hashes (>=16 chars). Optional in dev
# (falls back to a fixed dev-only value); the app refuses to boot in
# production without a real one set (see src/lib/env.ts).
# OTP_PEPPER=

# Object storage (Cloudflare R2 / S3-compatible). Optional in dev (falls back
# to local-filesystem storage under .local-storage/, served by
# app/api/uploads/local/[...path]); REQUIRED in production — the app refuses
# to boot without these rather than silently storing images on the app server.
# STORAGE_ENDPOINT=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_PUBLIC_CDN_URL=

# Sentry error tracking (Phase 8). Entirely optional in every environment,
# including production — until set, Sentry performs zero network activity
# and every other observability feature (structured logs, request-id,
# error boundaries) works regardless. See docs/OBSERVABILITY.md. The two
# are typically the same DSN; NEXT_PUBLIC_SENTRY_DSN must be prefixed that
# way to reach the browser bundle.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# SMS gateway for OTP codes and general notifications (order updates,
# moderation decisions, etc. — Phase 11). Optional in every environment;
# falls back to console logging (dev/test only) if unset. Deliberately
# vendor-agnostic (plain POST of { to, message } with a bearer token) —
# see src/modules/identity/sms.ts and docs/DECISIONS.md.
# SMS_PROVIDER_API_URL=
# SMS_PROVIDER_API_KEY=

# --- Reserved for later phases (kept here so the env schema documents the full
# eventual surface area; unused keys are optional until their phase lands) ---

# Phase 5 — payment providers (Paymob is implemented; see
# src/modules/payments/paymob-provider.ts — inert until these are set)
# PAYMOB_API_KEY=
# PAYMOB_INTEGRATION_ID=
# PAYMOB_IFRAME_ID=
# PAYMOB_HMAC_SECRET=

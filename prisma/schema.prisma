generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  INDIVIDUAL
  BUSINESS
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

model User {
  id                 String     @id @default(cuid())
  phone              String     @unique
  name               String?
  role               UserRole   @default(INDIVIDUAL)
  status             UserStatus @default(ACTIVE)
  phoneVerifiedAt    DateTime?
  commerceVerifiedAt DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  deletedAt          DateTime?

  listings             Listing[]
  sessions             Session[]
  verificationRequests VerificationRequest[]
  auditLogs            AuditLog[]             @relation("AuditActor")

  @@map("users")
}

enum OtpPurpose {
  LOGIN_OR_REGISTER
}

// Keyed by phone, not by user: a code can be requested before any User row
// exists yet (the OTP flow doubles as registration on first verification).
model OtpCode {
  id          String     @id @default(cuid())
  phone       String
  codeHash    String
  purpose     OtpPurpose @default(LOGIN_OR_REGISTER)
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())

  @@index([phone, createdAt])
  @@map("otp_codes")
}

// Opaque, server-revocable session tokens — only a hash is ever stored, so a
// database read alone can never yield a usable session token.
model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("sessions")
}

enum VerificationRequestType {
  INDIVIDUAL_SELLER
  BUSINESS
}

enum VerificationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// The submission path exists from Phase 2; the admin review UI lands in
// Phase 10. documentUrl stays optional until Phase 3 builds real uploads.
model VerificationRequest {
  id           String                    @id @default(cuid())
  userId       String
  user         User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         VerificationRequestType
  status       VerificationRequestStatus @default(PENDING)
  businessName String?
  documentUrl  String?
  notes        String?
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@index([userId])
  @@index([status])
  @@map("verification_requests")
}

enum AuditActorType {
  USER
  SYSTEM
}

model AuditLog {
  id         String         @id @default(cuid())
  actorId    String?
  actor      User?          @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorType  AuditActorType @default(USER)
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime       @default(now())

  @@index([actorId])
  @@index([action])
  @@map("audit_logs")
}

model Governorate {
  id     String @id @default(cuid())
  slug   String @unique
  nameAr String
  nameEn String

  cities City[]

  @@map("governorates")
}

model City {
  id            String      @id @default(cuid())
  slug          String
  nameAr        String
  nameEn        String
  governorateId String
  governorate   Governorate @relation(fields: [governorateId], references: [id], onDelete: Restrict)

  @@unique([governorateId, slug])
  @@index([governorateId])
  @@map("cities")
}

enum CategoryAttributeType {
  TEXT
  NUMBER
  SELECT
  BOOLEAN
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  nameAr    String
  nameEn    String
  icon      String?
  sortOrder Int       @default(0)
  deletedAt DateTime?

  attributes CategoryAttribute[]
  listings   Listing[]

  @@map("categories")
}

// Data-driven per-category form fields — admin-managed from Phase 9 onward,
// so the frontend never hardcodes a category's attribute set.
model CategoryAttribute {
  id         String                @id @default(cuid())
  categoryId String
  category   Category              @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  key        String
  labelAr    String
  labelEn    String
  type       CategoryAttributeType
  options    Json?
  required   Boolean               @default(false)
  sortOrder  Int                   @default(0)
  deletedAt  DateTime?

  @@unique([categoryId, key])
  @@index([categoryId])
  @@map("category_attributes")
}

// Minimal shell — Phase 3 adds status, images, attributes payload, pricing and geo fields.
model Listing {
  id         String    @id @default(cuid())
  title      String
  ownerId    String
  owner      User      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@index([categoryId])
  @@index([ownerId])
  @@map("listings")
}
